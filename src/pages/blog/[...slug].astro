---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { personalInfo } from "../../data/portfolio";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index + 1 < posts.length ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedPubDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.pubDate);
---

<Layout
  title={`${post.data.title} — ${personalInfo.name}`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
>
  <div class="container mx-auto px-5 sm:px-8 py-8 max-w-4xl">
    <Header />

    <main class="broadsheet-content">
      <article class="mb-14">
      <div class="mb-4 flex items-center justify-between text-xs text-secondary">
        <a
          href="/blog"
          class="underline underline-offset-4 hover:text-primary"
        >
          ← Back to Blog
        </a>
        <span>{readingTime} min read</span>
      </div>

      <header class="mb-8">
        <h1 class="font-display text-3xl sm:text-5xl font-bold leading-tight tracking-tight mb-4">
          {post.data.title}
        </h1>

        <p class="text-sm text-secondary leading-relaxed mb-6">
          {post.data.description}
        </p>

        <div class="newspaper-rule-double py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="text-secondary">
            <span>{personalInfo.name}</span>
            <span class="text-muted mx-2">•</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedPubDate}
            </time>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {
              post.data.tags.map((tag) => (
                <span class="ink-stamp">#{tag}</span>
              ))
            }
          </div>
        </div>
      </header>

      {
        post.data.heroImage && (
          <figure class="mb-8 border border-primary p-3 bg-surface/40">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full max-h-96 object-cover ink-illustration"
            />
            {post.data.heroImageCaption && (
              <figcaption class="text-xs text-muted mt-2 text-center">
                {post.data.heroImageCaption}
              </figcaption>
            )}
          </figure>
        )
      }

      <div class="prose-newspaper max-w-none">
        <Content />
      </div>
    </article>

    {
      (prevPost || nextPost) && (
        <nav
          aria-label="Adjacent Articles"
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 pt-6 border-t border-primary"
        >
          {prevPost ? (
            <a href={`/blog/${prevPost.id}`} class="ink-card p-4 block">
              <span class="text-[11px] uppercase tracking-wider text-muted block mb-1">
                ← Previous Post
              </span>
              <span class="font-display text-lg font-bold leading-snug">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.id}`}
              class="ink-card p-4 block sm:text-right"
            >
              <span class="text-[11px] uppercase tracking-wider text-muted block mb-1">
                Next Post →
              </span>
              <span class="font-display text-lg font-bold leading-snug">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
    </main>
  </div>
</Layout>
