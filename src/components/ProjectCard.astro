---
interface Props {
  title: string;
  kicker: string;
  story: string;
  stack: string[];
  link?: string;
}

const { title, kicker, story, stack, link } = Astro.props;
---

<article class:list={["ink-card p-5 flex flex-col justify-between h-full relative group", link && "cursor-pointer"]}>
  <div>
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-[11px] uppercase tracking-wider text-secondary font-medium">
        {kicker}
      </span>
      {
        link && (
          <span
            class="inline-flex items-center gap-1.5 text-xs text-secondary group-hover:text-primary group-hover:underline underline-offset-4"
          >
            <svg
              class="w-3.5 h-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>GitHub ↗</span>
          </span>
        )
      }
    </div>

    <h3 class="font-display text-xl font-bold leading-snug mb-2.5 border-b border-subtle pb-2">
      {
        link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline underline-offset-4 after:absolute after:inset-0"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    <p class="text-sm leading-relaxed text-secondary text-justify mb-4">
      {story}
    </p>
  </div>

  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-dashed border-subtle">
    {
      stack.map((tech) => (
        <span class="ink-stamp">{tech}</span>
      ))
    }
  </div>
</article>
