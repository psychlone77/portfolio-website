---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource-variable/playfair-display";
import playfairWoff2 from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import ibmPlexMono400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import ibmPlexMono500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import ibmPlexMono600 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";
import { personalInfo } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  pubDate?: Date;
  ogImage?: string;
}

const {
  title = "Nithika Dias — Portfolio",
  description = "Portfolio and blog of Nithika Dias — Software & Application Security Engineer.",
  type = "website",
  pubDate,
  ogImage,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://nithikadias.pages.dev";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteUrl);

const cleanPath = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const defaultOgSlug = cleanPath === "" ? "index" : cleanPath;
const resolvedOgImage = ogImage ?? `${siteUrl}/open-graph/${defaultOgSlug}.webp`;

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: pubDate?.toISOString(),
        author: {
          "@type": "Person",
          name: personalInfo.name,
          url: siteUrl,
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "Person",
        name: personalInfo.name,
        jobTitle: "Associate Engineer - Application Security",
        worksFor: {
          "@type": "Organization",
          name: "LSEG (London Stock Exchange Group)",
        },
        alumniOf: {
          "@type": "CollegeOrUniversity",
          name: "University of Moratuwa",
        },
        url: siteUrl,
        sameAs: personalInfo.socials.filter((s) => s.url.startsWith("http")).map((s) => s.url),
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph / Social -->
    <meta property="og:site_name" content={personalInfo.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="nithikadias.pages.dev" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- Critical Assets Preload for Instant FCP & LCP (Eliminates Chaining & Layout Shift) -->
    <link
      rel="preload"
      href={playfairWoff2}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={ibmPlexMono400}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={ibmPlexMono500}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={ibmPlexMono600}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      (Astro.url.pathname === "/" || Astro.url.pathname === "") && (
        <link
          rel="preload"
          href="/profile-image.webp"
          as="image"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <ClientRouter />

    <!-- Prevent Flash of Unstyled Content (FOUC) on initial load & view transition swaps -->
    <script is:inline>
      (function () {
        function getSavedTheme() {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") return saved;
          return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        // Apply immediately on initial render
        document.documentElement.setAttribute("data-theme", getSavedTheme());

        // CRITICAL: Synchronize theme BEFORE swap so incoming document already has dark/light mode set
        document.addEventListener("astro:before-swap", function (e) {
          const currentTheme =
            document.documentElement.getAttribute("data-theme") || getSavedTheme();
          e.newDocument.documentElement.setAttribute("data-theme", currentTheme);
        });

        // Ensure after-swap maintains theme in case of unexpected state
        document.addEventListener("astro:after-swap", function () {
          const currentTheme =
            document.documentElement.getAttribute("data-theme") || getSavedTheme();
          document.documentElement.setAttribute("data-theme", currentTheme);
        });
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <!-- 1. Organic Newspaper Crumple, Bumps & Fold Crease Layer (Persists without re-rendering across page transitions) -->
    <div class="paper-fold-creases" aria-hidden="true" transition:persist="paper-creases"></div>
    <svg class="paper-crumple-layer" aria-hidden="true" transition:persist="paper-crumple">
      <filter id="newspaper-crumple-relief" x="0%" y="0%" width="100%" height="100%">
        <!-- Macro paper crush & unevenness -->
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.011 0.015"
          numOctaves="5"
          seed="14"
          result="macroCrumple"></feTurbulence>
        <!-- Medium paper fiber bumps -->
        <feTurbulence
          type="turbulence"
          baseFrequency="0.045 0.055"
          numOctaves="4"
          seed="3"
          result="fiberBumps"></feTurbulence>
        <feBlend mode="multiply" in="macroCrumple" in2="fiberBumps" result="combinedSurface"
        ></feBlend>
        <!-- 3D Directional grazing light to bring out physical bumps and crush marks -->
        <feDiffuseLighting
          in="combinedSurface"
          lighting-color="#ffffff"
          surfaceScale="4.5"
          diffuseConstant="1.05"
          result="litPaper"
        >
          <feDistantLight azimuth="128" elevation="45"></feDistantLight>
        </feDiffuseLighting>
        <feColorMatrix
          type="matrix"
          values="0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0 0 0 1 0"
          in="litPaper"></feColorMatrix>
      </filter>
      <rect width="100%" height="100%" filter="url(#newspaper-crumple-relief)"></rect>
    </svg>

    <!-- 2. Global Full-Page Fine Grain Filter & SVG Ink-Bleed Filter (Persists without re-rendering) -->
    <svg class="screen-grain-overlay" aria-hidden="true" transition:persist="screen-grain">
      <defs>
        <!-- Letterpress Ink-Bleed & Edge Roughening Filter for Display Headlines & Section Rules -->
        <filter id="ink-bleed" x="-20%" y="-35%" width="140%" height="170%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.045 0.065"
            numOctaves="3"
            seed="5"
            result="lineWobble"></feTurbulence>
          <feTurbulence
            type="turbulence"
            baseFrequency="0.35"
            numOctaves="2"
            seed="11"
            result="fiberEdge"></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            in2="lineWobble"
            scale="1.4"
            xChannelSelector="R"
            yChannelSelector="G"
            result="wobbled"></feDisplacementMap>
          <feDisplacementMap
            in="wobbled"
            in2="fiberEdge"
            scale="0.7"
            xChannelSelector="R"
            yChannelSelector="B"></feDisplacementMap>
        </filter>

        <!-- Gentle Letterpress Ink-Bleed Filter for Stamps, Navbar, Body Text & Cards -->
        <filter id="ink-bleed-subtle" x="-15%" y="-25%" width="130%" height="150%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.05 0.07"
            numOctaves="3"
            seed="8"
            result="subtleWobble"></feTurbulence>
          <feTurbulence
            type="turbulence"
            baseFrequency="0.4"
            numOctaves="2"
            seed="15"
            result="subtleFiber"></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            in2="subtleWobble"
            scale="0.7"
            xChannelSelector="R"
            yChannelSelector="G"
            result="subtleWarped"></feDisplacementMap>
          <feDisplacementMap
            in="subtleWarped"
            in2="subtleFiber"
            scale="0.52"
            xChannelSelector="R"
            yChannelSelector="B"></feDisplacementMap>
        </filter>
      </defs>
      <filter id="global-print-grain" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.85"
          numOctaves="4"
          seed="9"
          stitchTiles="noStitch"
          result="rawGrain"></feTurbulence>
        <!-- Convert to monochrome centered at 0.5 gray so hard-light affects both black text and light paper -->
        <feColorMatrix
          type="matrix"
          values="0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0.33 0.33 0.33 0 0
                  0 0 0 1 0"
          in="rawGrain"
          result="monoGrain"></feColorMatrix>
        <feComponentTransfer in="monoGrain">
          <feFuncR type="linear" slope="2.6" intercept="-0.8"></feFuncR>
          <feFuncG type="linear" slope="2.6" intercept="-0.8"></feFuncG>
          <feFuncB type="linear" slope="2.6" intercept="-0.8"></feFuncB>
        </feComponentTransfer>
      </filter>
      <rect width="100%" height="100%" filter="url(#global-print-grain)"></rect>
    </svg>

    <div class="relative z-10 flex-1 flex flex-col justify-between min-h-screen">
      <div class="flex-1">
        <slot />
      </div>

      <footer
        class="newspaper-footer relative z-10 container mx-auto px-5 sm:px-8 max-w-4xl pb-12 pt-4"
      >
        <div
          class="newspaper-rule-double pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs text-secondary"
        >
          <p class="font-medium text-primary">
            {personalInfo.name}
          </p>

          <div class="flex flex-wrap items-center gap-5">
            {
              personalInfo.socials.map((s) => (
                <a
                  href={s.url}
                  target={s.url.startsWith("http") ? "_blank" : undefined}
                  rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 hover:underline underline-offset-4 text-secondary hover:text-primary transition-colors"
                >
                  {s.icon === "github" && (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                  )}
                  {s.icon === "linkedin" && (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                  {s.icon === "email" && (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  )}
                  <span>{s.label}</span>
                </a>
              ))
            }
            <a
              href="/blog"
              class="hover:underline underline-offset-4 text-secondary hover:text-primary transition-colors"
            >
              Blog
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
